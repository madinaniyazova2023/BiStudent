# В Railway → Variables. Замените домен и пароль своими значениями.
# Сначала подключите Volume /data и создайте HTTPS-домен с target port 8080.
PORT=8080
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Default=Data Source=/data/bistudent.db
Hosting__Public=true
Hosting__RailwayProxy=true
Enrollment__PublicUrl=https://YOUR-SERVICE.up.railway.app
Setup__AdminLogin=admin
Setup__AdminPassword=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_12_CHARACTERS
Demo__Enabled=false
# Существующая общая база. Значения уже есть в appsettings.json.
# Удалите пустые Firebase__ApiKey / Firebase__ProjectId из Variables Railway,
# иначе они переопределят подключение из appsettings.json.
# Для отдельной автономной установки задайте оба значения пустыми.
# Образ работает от app, а Railway монтирует Volume от root.
RAILWAY_RUN_UID=0
TZ=Asia/Qyzylorda
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
